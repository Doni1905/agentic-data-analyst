# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL=postgresql://ada:ada@localhost:5432/sales_db

# --- LLM provider: "gemini" (default, free tier) or "groq" ---
LLM_PROVIDER=gemini

# Gemini free tier: get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq free tier alternative: get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Agent behaviour
MAX_SQL_RETRIES=3
